# Anthropic — used by LiteLLM for all Claude model calls
ANTHROPIC_API_KEY=sk-ant-...

# GitHub — personal access token; needs pull_requests:write scope only
GITHUB_TOKEN=ghp_...

# LangFuse — observability traces
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Team Brain MCP server — set if running the server on a non-default address
# Start the server with: uv run python -m src.team_brain.server
TEAM_BRAIN_URL=http://127.0.0.1:8000/sse
